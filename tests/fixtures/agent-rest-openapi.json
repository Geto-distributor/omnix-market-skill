{
  "openapi": "3.0.1",
  "paths": {
    "/api/market-intelligence/v1/reference-data": {
      "get": {"operationId": "GetMarketReferenceData"}
    },
    "/api/market-intelligence/v1/markets/{marketCode}/companies": {
      "get": {
        "operationId": "ListCompanies",
        "parameters": [
          {
            "name": "scopeCode",
            "in": "query",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "contentStatus",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["Published", "Draft"]}
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["contentStatus", "draftKey", "resourceKey"],
                        "properties": {
                          "contentStatus": {"type": "string", "enum": ["Draft"]},
                          "draftKey": {"type": "string", "minLength": 1},
                          "resourceKey": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/market-intelligence/v1/markets/{marketCode}/companies:resolve": {
      "post": {
        "operationId": "ResolveCompany",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/ResolveCompanyRequest"}}
          }
        }
      }
    },
    "/api/market-intelligence/v1/markets/{marketCode}/sources": {
      "get": {
        "operationId": "ListSources",
        "parameters": [
          {
            "name": "scopeCode",
            "in": "query",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "contentStatus",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["Published", "Draft"]}
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["contentStatus", "draftKey", "sourceKey"],
                        "properties": {
                          "contentStatus": {"type": "string", "enum": ["Draft"]},
                          "draftKey": {"type": "string", "minLength": 1},
                          "sourceKey": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/market-intelligence/v1/markets/{marketCode}/drafts/companies": {
      "post": {
        "operationId": "CreateCompanyDraft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/CompanyDraftRequest"}}
          }
        }
      }
    },
    "/api/market-intelligence/v1/markets/{marketCode}/drafts/companies/{resourceKey}": {
      "put": {
        "operationId": "UpdateCompanyDraft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/CompanyDraftRequest"}}
          }
        }
      },
      "delete": {"operationId": "DeleteCompanyDraft"}
    },
    "/api/market-intelligence/v1/markets/{marketCode}/drafts:validate": {
      "post": {
        "operationId": "ValidateMarketDrafts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/ValidateDraftsRequest"}}
          }
        }
      }
    },
    "/api/market-intelligence/v1/markets/{marketCode}/drafts:submit": {
      "post": {
        "operationId": "SubmitMarketDrafts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/SubmitDraftsRequest"}}
          }
        }
      }
    },
    "/api/market-intelligence/v1/markets/{marketCode}/drafts": {
      "get": {"operationId": "ForbiddenOwnerDraftList"}
    },
    "/api/market-intelligence/v1/markets/{marketCode}/approvals": {
      "get": {"operationId": "ForbiddenApprovalQueue"}
    }
  },
  "components": {
    "schemas": {
      "ResolveCompanyRequest": {
        "type": "object",
        "required": ["canonicalName"],
        "additionalProperties": false,
        "properties": {
          "canonicalName": {"type": "string", "minLength": 1},
          "primaryDomain": {"type": "string", "nullable": true}
        }
      },
      "CompanyDraftRequest": {
        "type": "object",
        "required": ["resourceKey", "canonicalName"],
        "additionalProperties": false,
        "properties": {
          "resourceKey": {"type": "string", "minLength": 1},
          "canonicalName": {"type": "string", "minLength": 1}
        }
      },
      "ValidateDraftsRequest": {
        "type": "object",
        "required": ["draftKeys"],
        "additionalProperties": false,
        "properties": {
          "draftKeys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      },
      "SubmitDraftsRequest": {
        "type": "object",
        "required": ["draftKeys"],
        "additionalProperties": false,
        "properties": {
          "draftKeys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
