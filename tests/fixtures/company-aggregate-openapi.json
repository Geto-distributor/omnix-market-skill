{
  "openapi": "3.0.1",
  "paths": {
    "/api/market-intelligence/companies": {
      "get": {
        "operationId": "ListCompanies",
        "responses": {"200": {"content": {"application/json": {"schema": {"type": "object"}}}}}
      },
      "post": {
        "operationId": "CreateCompany",
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyRequest"}}}},
        "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyResponse"}}}}}
      }
    },
    "/api/market-intelligence/companies:resolve": {
      "post": {
        "operationId": "ResolveCompany",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["entityKind"], "properties": {"entityKind": {"type": "string"}, "registrationNumber": {"type": "string"}, "domain": {"type": "string"}}, "additionalProperties": false}}}},
        "responses": {"200": {"content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    },
    "/api/market-intelligence/companies/{companyKey}": {
      "get": {"operationId": "GetCompany", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyResponse"}}}}}},
      "put": {"operationId": "UpdateCompany", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyRequest"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyResponse"}}}}}},
      "patch": {"operationId": "PatchCompany", "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"visibility": {"type": "string", "enum": ["private", "public"]}}, "additionalProperties": false}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyResponse"}}}}}},
      "delete": {"operationId": "DeleteCompany", "responses": {"200": {"content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/market-intelligence/companies/{companyKey}:restore": {
      "post": {"operationId": "RestoreCompany", "requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyResponse"}}}}}}
    }
  },
  "components": {
    "schemas": {
      "CompanyRequest": {
        "type": "object",
        "required": ["company", "visibility"],
        "properties": {
          "company": {"type": "object"},
          "visibility": {"type": "string", "enum": ["private", "public"]},
          "researchClassifications": {"type": "array", "items": {"type": "object"}},
          "productsAndServices": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      },
      "CompanyResponse": {
        "type": "object",
        "required": ["companyKey", "visibility", "detailRoute"],
        "properties": {
          "companyKey": {"type": "string"},
          "visibility": {"type": "string", "enum": ["private", "public"]},
          "detailRoute": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  }
}
